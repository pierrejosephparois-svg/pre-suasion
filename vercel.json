{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/notre-solution", "destination": "/solution.html" }
  ],
  "redirects": [
    { "source": "/solution", "destination": "/notre-solution", "permanent": true },
    { "source": "/solution.html", "destination": "/notre-solution", "permanent": true }
  ]
}
